<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

    <header>
        <h1>Book Borrowing Library</h1>
        <p>Find your next favorite book!</p>
    </header>

    <%- include('partials/navbar') %>

    <main class="catalogue-content">
        <h2><%= genre %> Books</h2>
        <p>Explore books in the <%= genre %> category.</p>

        <div class="genre-grid">
            <div class="genre-card"><%= genre %>Book 1</div>
            <div class="genre-card"><%= genre %>Book 2</div>
            <div class="genre-card"><%= genre %>Book 3</div>
        </div>

        <p>
            <a href="/genre" class="borrow-button">
                Back to Genres
            </a>
        </p>
    </main>

    <footer>
        <p>&copy; 2026 Book Borrowing Library</p>
    </footer>

</body>
</html>
