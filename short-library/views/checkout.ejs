<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width", initial-scale="1.0">   
    <title>Borrow Book | Book Borrowing Library</title>
    <link rel='stylesheet' href='/stylesheets/style.css'>
  </head>
  <body>
    <header>
      <h1>Book Borrowing Library</h1>
      <p>Find your next favorite book!</p>
    </header>

    <%- include('partials/navbar')%>
    <main class="checkout-content">
      <h2>Borrow a Book</h2>
      <p>Complete the form below to borrow a book.</p>

      <form action="/checkout" method="POST" class="borrow-form">

        <label for="bookTitle">Book Title</label>
        <input
        type="text"
        id="bookTitle"
        name="bookTitle"
        value="<%= book ? book.title : '' %>"
        placeholder="Enter book title"
        readonly
        required
      >
      <% if (book) { %>
        <input type="hidden" name="bookId" value="<%= book.id %>">
      <% } %>

        <label for="fullname">Full Name</label>
        <input type="text" id="fullName" name="fullName"
               placeholder="Enter your full name" required>

        <label for="studentId">Student ID</label>
        <input type="text" id="studentId" name="studentId"
               placeholder="Enter your student ID" required>
        
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email"
               placeholder="Enter your email" required>

        <label for="borrowDate">Borrow Date</label>
        <input type="date" id="borrowDate" name="borrowDate" required>

        <label for="returnDate">Return Date</label>
        <input type="date" id="returnDate" name="returnDate" required>

        <button type="submit" class="borrow-button">
          Confirm Borrowing
        </button>

      </form>
    </main>

    <footer>
      <p>&copy; 2026 Book Borrowing Library.</p>
    </footer>
    
  </body>
</html>
